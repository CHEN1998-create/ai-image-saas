# Supabase PostgreSQL 直连配置 — 复制为 .env.local 并填入真实值
# 获取：Supabase Dashboard(https://supabase.com/dashboard) → 你的项目
#      → 顶部「Connect」按钮 → 选「Session Pooler」
#      → 复制 Host / Port / Database / User，并填建项目时设的数据库密码
# .env.local 已在 .gitignore；请勿把密码贴聊天或提交

PGHOST=aws-0-your-region.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=your-db-password

# Supabase 强制 SSL
PGSSL=true

# Supabase Storage（图片对象存储）
# 生产/能直连 Supabase 的环境：
#   NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# 本地（国内无法直连）：用 Cloudflare Worker 中继，部署见 supabase-relay.js：
#   NEXT_PUBLIC_SUPABASE_URL=https://your-worker.your-sub.workers.dev
# service_role key：Project Settings → API → service_role（Reveal）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# 自定义 HMAC cookie 会话签名密钥（本地留空用默认 dev secret）
AUTH_SECRET=

# Stripe（本地用测试模式）
# Secret key：https://dashboard.stripe.com/test/apikeys → sk_test_...
# Webhook secret：`stripe listen --forward-to localhost:3000/api/stripe/webhook`
#   启动后终端输出 whsec_...
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
