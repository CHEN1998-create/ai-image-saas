# Supabase PostgreSQL 直连配置 — 复制为 .env.local 并填入真实值
# 获取：Supabase Dashboard(https://supabase.com/dashboard) → 你的项目
#      → 顶部「Connect」按钮 → 选「Session Pooler」
#      → 复制 Host / Port / Database / User，并填建项目时设的数据库密码
# .env.local 已在 .gitignore；请勿把密码贴聊天或提交

PGHOST=aws-0-your-region.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=your-db-password

# Supabase 强制 SSL
PGSSL=true

# Supabase Storage（图片对象存储）
# 获取：Project Settings → API → Project URL / service_role key（点 Reveal）
# 另需在 Dashboard → Storage 建 public bucket：generated-images
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# 自定义 HMAC cookie 会话签名密钥（本地留空用默认 dev secret）
AUTH_SECRET=
